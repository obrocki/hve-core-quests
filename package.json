{
  "name": "hve-core-quests",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "scripts": {
    "eval:lint": "vally lint --eval-spec evals/eagledesk-quests/eval.yaml && vally lint --eval-spec evals/generated-playground/composition.eval.yaml && vally lint --eval-spec evals/generated-playground/behavioral.eval.yaml",
    "eval": "node scripts/eval-preflight.cjs",
    "eval:composition": "node evals/generated-playground/program.cjs composition",
    "eval:evidence": "node evals/generated-playground/program.cjs evidence",
    "live:preflight": "node evals/generated-playground/live-lane.cjs preflight",
    "live:grade": "node evals/generated-playground/live-lane.cjs grade",
    "test:generated": "node --test tests/generated-playground.test.cjs tests/hve-live-lane.test.cjs",
    "test": "node --test tests/*.test.cjs"
  },
  "devDependencies": {
    "@microsoft/vally": "0.20.0",
    "@microsoft/vally-cli": "0.20.0",
    "acorn": "8.19.0",
    "eslint-scope": "8.4.0",
    "parse5": "8.1.1",
    "playwright-core": "1.65.1",
    "yaml": "2.9.1"
  }
}
